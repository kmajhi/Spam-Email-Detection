# Copy this file to `.env` in the backend/ directory and adjust as needed.
# .env is not committed to version control.

# Django secret key. Generate your own for any non-local use, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me

# Never enable DEBUG in a real deployment.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins the React dev server may call the API from.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
